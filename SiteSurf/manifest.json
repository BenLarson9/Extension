{
"manifest_version": 3,

"name": "SiteSurf",

"version": "1.0.0",

"description": "Welcom to SiteSurf, A new extension that helps you surf the web unhindered.",



"permissions": ["activeTab", "declarativeContent", "storage", "<all_urls>"],

"content_scripts": [
    {	
	"matches": ["<all_urls>"],

	"css": ["css1.css"],

	"js": ["javascript1.js"]
    }
],


"action": {
    "default_title": "Sign In Prompt Removal",

    "default_popup": "popup.html"},

    "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png"}


}